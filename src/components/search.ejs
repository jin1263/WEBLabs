<form class="search" role="search" action="cookbook.html" method="get" aria-label="<%= t.search.form %>" data-i18n-aria-label="search.form">
    <label class="search__label" for="<%= searchId %>" data-i18n="search.label"><%= t.search.label %></label>
    <input class="search__input" id="<%= searchId %>" name="q" type="search" minlength="2" maxlength="100"
           autocomplete="off" placeholder="<%= t.search.placeholder %>" data-i18n-placeholder="search.placeholder" aria-describedby="<%= searchId %>-hint">
    <button class="search__button" type="submit" data-i18n="search.find"><%= t.search.find %></button>
    <p class="search__hint" id="<%= searchId %>-hint" data-i18n="search.hint"><%= t.search.hint %></p>
</form>
