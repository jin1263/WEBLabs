<picture class="picture">
    <source type="image/webp"
            srcset="<%= image %>-320.webp 320w, <%= image %>-640.webp 640w, <%= image %>-960.webp 960w"
            sizes="320px">
    <img class="picture__image" src="<%= image %>-320.jpg"
         srcset="<%= image %>-320.jpg 320w, <%= image %>-640.jpg 640w, <%= image %>-960.jpg 960w"
         sizes="320px" width="320" height="213" alt="<%= alt %>"
         <% if (altKey) { %>data-i18n-alt="<%= altKey %>"<% } %>
         loading="<%= eager ? 'eager' : 'lazy' %>" decoding="async">
</picture>
