      "steps": [
        {
          "key": "pasta",
          "title": "Cook the pasta",
          "text": "Cook the pasta in salted boiling water following the package instructions. Reserve a small cup of the cooking water, then drain."
        },
        {
          "key": "chicken",
          "title": "Prepare the chicken",
          "text": "Cut the chicken into bite-sized pieces. Heat the olive oil in a pan and cook the chicken until cooked through. Add the garlic and stir until fragrant."
        },
        {
          "key": "sauce",
          "title": "Make the sauce",
          "text": "Lower the heat, add the cream, and stir in the Parmesan. Add a little reserved pasta water if the sauce is too thick."
        },
        {
          "key": "serve",
          "title": "Combine and serve",
          "text": "Add the pasta to the pan and stir to coat. Season with salt and black pepper, then serve with fresh parsley."
        }
      ]
    }
